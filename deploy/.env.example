# ══════════════════════════════════════════════════════════════════════════════
# Eitashot — Production Environment Variables
#
# Copy this file to .env and fill in every value marked [REQUIRED].
# Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════


# ── Domain ────────────────────────────────────────────────────────────────────

# Your domain name, e.g. eitashot.example.com
# Caddy uses this to obtain an automatic HTTPS certificate.
# [REQUIRED]
DOMAIN=yourdomain.com


# ── PostgreSQL database ───────────────────────────────────────────────────────

# Username for the PostgreSQL superuser created inside the container.
# Used only by the postgres container itself.
# [REQUIRED] — change from default
POSTGRES_USER=eitashot

# Password for the PostgreSQL superuser.
# [REQUIRED] — must be a strong random password
POSTGRES_PASSWORD=change_this_strong_password

# Name of the database to create on first startup.
# [REQUIRED]
POSTGRES_DB=eitashot

# Full connection string used by the API server and migration runner.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# The host must match the postgres service name in docker-compose.yml ("postgres").
# [REQUIRED] — keep in sync with the three POSTGRES_* variables above
DATABASE_URL=postgresql://eitashot:change_this_strong_password@postgres:5432/eitashot


# ── Authentication secrets ────────────────────────────────────────────────────

# Secret used to sign JWT session tokens.
# Must be a long random string. Generate one with: openssl rand -hex 64
# [REQUIRED] — must be replaced with a unique secret
SESSION_SECRET=replace_with_a_long_random_string_at_least_64_chars

# Token obtained from your Eitaa bot.
# The server uses this to verify that incoming login requests originate from
# your actual Eitaa mini-app. Without this, anyone could forge login requests.
# [REQUIRED] — obtain from your Eitaa bot settings
EITAA_BOT_TOKEN=your_eitaa_bot_token_here


# ── Administrator account ─────────────────────────────────────────────────────

# The username of the account that has access to the admin panel (/admin).
# This account must be created through the normal registration flow after
# the first deployment.
# [REQUIRED]
ADMIN_USERNAME=your_admin_username


# ── IDPay payment gateway ─────────────────────────────────────────────────────

# Your IDPay merchant API key.
# Obtain this from your IDPay merchant dashboard (https://idpay.ir).
# In production (NODE_ENV=production), the sandbox mode is automatically
# disabled and real payments are processed.
# [REQUIRED for payments to work]
IDPAY_API_KEY=your_idpay_api_key_here


# ── Application URLs ──────────────────────────────────────────────────────────

# The public base URL of the API server as seen from the internet.
# IDPay uses this URL to send payment callback notifications.
# Must be the same as your domain with https.
# [REQUIRED]
APP_BASE_URL=https://yourdomain.com

# The public base URL of the frontend application.
# Used for payment success/failure redirects.
# [REQUIRED]
FRONTEND_URL=https://yourdomain.com


# ── Optional pricing configuration ───────────────────────────────────────────

# Price per advertisement window slot in Tomans (default: 50000).
# Optional — defaults to 50000 if not set.
# AD_WINDOW_PRICE_TOMANS=50000

# How many minutes an unpaid ad slot reservation stays active before expiring.
# Optional — defaults to 30 if not set.
# RESERVATION_TIMEOUT_MINUTES=30

# How many expired unpaid reservations from one IP trigger a temporary block.
# Optional — defaults to 3 if not set.
# MAX_EXPIRED_RESERVATIONS=3

# Starting date for the current donation fundraising cycle (ISO 8601 format).
# Optional — defaults to the first day of the current UTC month if not set.
# DONATION_CYCLE_START=2025-01-01T00:00:00Z
