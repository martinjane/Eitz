# ──────────────────────────────────────────────────────────────────────────────
# Eitashot — Frontend (React + Vite)
# Build context: root of the monorepo (one level above this file)
# Usage: docker build -f deploy/Dockerfile.frontend -t eitashot-frontend .
# ──────────────────────────────────────────────────────────────────────────────

# Stage 1 — Builder: compile the React app into static files
FROM --platform=linux/amd64 node:22-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.26.1 --activate

WORKDIR /workspace

# Copy workspace manifests first for better layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# Copy all workspace packages the frontend depends on
COPY lib/ lib/
COPY artifacts/eitashot/ artifacts/eitashot/

RUN pnpm install --frozen-lockfile

# Vite build — outputs to artifacts/eitashot/dist/public/
# BASE_PATH defaults to "/" (root-mounted app)
ENV NODE_ENV=production
ENV BASE_PATH=/
RUN pnpm --filter @workspace/eitashot run build


# ──────────────────────────────────────────────────────────────────────────────
# Stage 2 — Runtime: nginx serving the compiled static files
# ──────────────────────────────────────────────────────────────────────────────
FROM --platform=linux/amd64 nginx:1.27-alpine AS runtime

# Remove the default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled frontend
COPY --from=builder /workspace/artifacts/eitashot/dist/public /usr/share/nginx/html

# nginx config that handles SPA routing (all paths fall back to index.html)
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
