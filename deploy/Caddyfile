# ──────────────────────────────────────────────────────────────────────────────
# Caddy reverse-proxy configuration
#
# For IP-based testing: serves HTTP on port 80, no HTTPS (no domain).
# For production with a domain: change to {$DOMAIN} and uncomment TLS block.
# ──────────────────────────────────────────────────────────────────────────────

:80 {
    # Route all API requests to the backend container
    reverse_proxy /api/* api:3001 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }

    # Route everything else to the frontend container
    reverse_proxy * frontend:80

    # Enable access logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MB
            roll_keep 5
        }
    }
}
